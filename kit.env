# iot-kit settings, sourced by the scripts (bash syntax).
#
# The LAN values are fixed decisions and are also written literally in
# configs/ (dnsmasq, nftables, chrony). If you ever change one here, grep
# configs/ for the old value and change it there too.

KIT_HOSTNAME=iot-kit
TIMEZONE=Europe/Paris

LAN_IF=eth0
LAN_IP=192.168.50.1
LAN_PREFIX=24

# WAN uplink over USB-Ethernet. wlan0 is the other possible uplink; join a
# WiFi with `sudo nmcli device wifi connect <ssid> --ask`.
WAN_ETH_IF=eth1

# DHCP servers on the host network whose offers the Pi must refuse (space
# separated addresses, may be empty). Useful when the host network has a rogue
# DHCP server handing out addresses without internet, see Troubleshooting in
# the README.
WAN_DHCP_REJECT_SERVERS=""

# MAC of the UAP-AC-HD (printed on its label / shown in the controller).
# Once set, re-run scripts/phase2-dnsmasq.sh to reserve AP_IP for it.
AP_MAC=
AP_IP=192.168.50.2

# Site-specific values (AP_MAC, rejected DHCP servers, ...) go in
# kit.local.env next to this file: it is not tracked by git, overrides
# anything above, and deploy.sh copies it to the Pi.
