    {
        "id": "a1f0c0de00000021",
        "type": "function",
        "z": "a1f0c0de00000001",
        "name": "last value per topic",
        "func": "// One row per topic, newest value wins. Bounded so that a board\n// publishing to random topics cannot fill the memory.\nconst MAX_TOPICS = 200;\n\n// Node-RED also hands the broker's own statistics to a '#' subscription\nif (msg.topic.startsWith('$SYS/')) return null;\n\nconst rows = context.get('rows') || {};\n\nlet value = msg.payload;\nif (Buffer.isBuffer(value)) value = value.toString();\nif (typeof value === 'object') value = JSON.stringify(value);\nvalue = String(value);\nif (value.length > 80) value = value.slice(0, 77) + '...';\n\nif (!(msg.topic in rows) && Object.keys(rows).length >= MAX_TOPICS) {\n    return null;\n}\nrows[msg.topic] = {\n    topic: msg.topic,\n    value: value,\n    time: new Date().toLocaleTimeString('fr-FR'),\n};\ncontext.set('rows', rows);\n\nmsg.payload = Object.values(rows).sort((a, b) => a.topic.localeCompare(b.topic));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 300,
        "wires": [["a1f0c0de00000022"]]
    },
